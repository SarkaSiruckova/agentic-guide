---
/**
 * Bottom navigation: a small "Previous" box and a larger "Next up" box.
 * The next page's title and link come from the sidebar order; the sentence
 * under it comes from the page's own "## Next up" section, which the rehype
 * add-on removes from the article body so it only appears here.
 */
import { getCollection } from 'astro:content';
import { parts } from '../data/concept-map';

const { pagination, entry } = Astro.locals.starlightRoute;

// "Tick off as read": only on guide pages that appear on the concept map.
// Ticks live in the reader's browser (localStorage key guide-map-read),
// shared with the concept map page, so ticking here shows there too.
const dirs = new Set(parts.map((p) => p.dir));
const trackable = dirs.has(entry.id.split('/')[0]);
const pageId = '/' + entry.id.replace(/\/index$/, '') + '/';
const total = trackable ? (await getCollection('docs')).filter((e) => dirs.has(e.id.split('/')[0])).length : 0;
const { prev, next } = pagination;

const body: string = (entry as { body?: string }).body ?? '';
const match = body.match(/(?:^|\n)## Next up[ \t]*\n([\s\S]*?)(?=\n## |\s*$)/);
const nextText = match ? match[1].trim() : '';

// Minimal inline markdown: escape, then links, bold, italics and code.
function inline(md: string): string {
  let s = md.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  s = s.replace(/`([^`]+)`/g, '<code>$1</code>');
  s = s.replace(/\[([^\]]+)\]\(([^)\s]+)\)/g, '<a href="$2">$1</a>');
  s = s.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');
  s = s.replace(/(^|[^*])\*([^*\s][^*]*)\*/g, '$1<em>$2</em>');
  return s;
}
const paragraphs = nextText ? nextText.split(/\n\s*\n/).map((p) => inline(p.replace(/\n/g, ' '))) : [];
---

{
  trackable && (
    <div class="guide-tick print:hidden" data-page={pageId} data-total={total}>
      <button type="button" class="guide-tick-btn" aria-pressed="false">
        <span class="guide-tick-dot" aria-hidden="true" />
        <span class="guide-tick-label">Tick off as read</span>
      </button>
      <span class="guide-tick-count" />
      <a class="guide-tick-map" href={`/concept-map/#${pageId}`}>See it on the concept map →</a>
    </div>
  )
}

<script is:inline>
  (function () {
    var KEY = 'guide-map-read';
    document.querySelectorAll('.guide-tick').forEach(function (box) {
      var id = box.dataset.page, total = box.dataset.total;
      var btn = box.querySelector('.guide-tick-btn'), label = box.querySelector('.guide-tick-label'), count = box.querySelector('.guide-tick-count');
      function load() { try { return JSON.parse(localStorage.getItem(KEY) || '[]'); } catch (e) { return []; } }
      function show() {
        var read = load(), on = read.indexOf(id) >= 0;
        btn.setAttribute('aria-pressed', on ? 'true' : 'false');
        label.textContent = on ? 'Ticked off as read' : 'Tick off as read';
        count.textContent = read.length ? read.length + ' of ' + total + ' ticked off' : '';
      }
      btn.addEventListener('click', function () {
        var read = load(), i = read.indexOf(id);
        if (i >= 0) read.splice(i, 1); else read.push(id);
        try { localStorage.setItem(KEY, JSON.stringify(read)); } catch (e) {}
        show();
      });
      show();
    });
  })();
</script>

{
  (prev || next) && (
    <nav class:list={['guide-pager', 'print:hidden', { 'has-prev': !!prev, 'has-next': !!next }]} aria-label="Pagination">
      {prev && (
        <a class="guide-pager-prev" href={prev.href} rel="prev">
          <span class="guide-pager-arrow" aria-hidden="true">←</span>
          <span>
            <span class="guide-pager-kicker">Previous</span>
            <span class="guide-pager-prev-title">{prev.label}</span>
          </span>
        </a>
      )}
      {next && (
        <div class="guide-pager-next">
          <div class="guide-pager-next-text">
            <p class="guide-pager-next-title">
              <span class="guide-pager-kicker">Next up:</span> <a href={next.href}>{next.label}</a>
            </p>
            {paragraphs.map((p) => <p class="guide-pager-next-body" set:html={p} />)}
          </div>
          <a class="guide-pager-button" href={next.href} rel="next" aria-label={`Next: ${next.label}`}>
            <span aria-hidden="true">→</span>
          </a>
        </div>
      )}
    </nav>
  )
}

<style>
  .guide-tick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    margin: 3rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-family: var(--sl-font);
  }
  .guide-tick-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-4);
    background: transparent;
    color: var(--sl-color-white);
    cursor: pointer;
    transition: border-color 0.15s, background 0.15s;
  }
  .guide-tick-btn:hover {
    border-color: var(--sl-color-accent);
  }
  .guide-tick-dot {
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    border: 2px solid var(--sl-color-accent);
    display: grid;
    place-items: center;
    font-size: 0.7rem;
    line-height: 1;
  }
  .guide-tick-btn[aria-pressed='true'] {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
  }
  .guide-tick-btn[aria-pressed='true'] .guide-tick-dot {
    background: var(--sl-color-accent);
  }
  .guide-tick-btn[aria-pressed='true'] .guide-tick-dot::after {
    content: '✓';
    color: var(--sl-color-black);
    font-weight: 700;
  }
  .guide-tick-count {
    font-size: 0.85rem;
    color: var(--sl-color-gray-3);
  }
  .guide-tick-map {
    margin-left: auto;
    font-size: 0.9rem;
    color: var(--sl-color-gray-2);
    text-underline-offset: 3px;
  }
  .guide-tick-map:hover {
    color: var(--sl-color-white);
  }
  .guide-pager {
    display: grid;
    gap: 1rem;
    align-items: stretch;
  }
  .guide-pager.has-prev.has-next {
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
  }
  .guide-pager-prev {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    padding: 1rem 1.1rem;
    text-decoration: none;
    color: var(--sl-color-gray-2);
    transition: border-color 0.15s;
  }
  .guide-pager-prev:hover {
    border-color: var(--sl-color-gray-3);
  }
  .guide-pager-arrow {
    font-size: 1.1rem;
    color: var(--sl-color-gray-3);
    flex-shrink: 0;
  }
  .guide-pager-kicker {
    display: block;
    font-family: var(--sl-font);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .guide-pager-prev-title {
    display: block;
    font-family: var(--sl-font);
    font-weight: 600;
    font-size: 1rem;
    line-height: 1.3;
    color: var(--sl-color-white);
    margin-top: 0.15rem;
  }
  .guide-pager-next {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    border: 1px solid var(--sl-color-accent);
    border-radius: 12px;
    padding: 1.1rem 1.25rem 1.1rem 1.5rem;
  }
  .guide-pager-next-text {
    flex: 1;
    min-width: 0;
  }
  .guide-pager-next-title {
    margin: 0;
    font-family: var(--sl-font);
    font-weight: 600;
    font-size: 1.15rem;
    line-height: 1.35;
    color: var(--sl-color-white);
  }
  .guide-pager-next-title .guide-pager-kicker {
    display: inline;
    font-size: inherit;
    letter-spacing: 0;
    text-transform: none;
    color: var(--sl-color-accent);
  }
  .guide-pager-next-title a {
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .guide-pager-next-title a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .guide-pager-next-body {
    margin: 0.4rem 0 0;
    font-family: var(--guide-body-font);
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
  }
  .guide-pager-next-body :global(a) {
    color: var(--sl-color-white);
    text-underline-offset: 3px;
  }
  .guide-pager-button {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: var(--sl-color-black);
    font-size: 1.2rem;
    text-decoration: none;
    transition: background 0.15s, transform 0.15s;
  }
  .guide-pager-button:hover {
    background: var(--sl-color-accent-high);
    transform: translateX(2px);
  }
  @media (max-width: 50rem) {
    .guide-pager.has-prev.has-next {
      grid-template-columns: 1fr;
    }
    .guide-pager-next {
      order: -1;
    }
  }
</style>
