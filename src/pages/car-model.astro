It("b6","Reasoning models",null,560,150,"A turbo that pauses to think before pulling away.","Reasoning models spend extra tokens working through a problem step by step. Slower and dearer, better for hard maths, code and planning.",["Claude extended thinking","OpenAI reasoning models","Gemini thinking","DeepSeek reasoning models"]),
It("b7","Fine-tuning",null,100,275,"A specialist remapping the engine for one job.","Further training on your own examples to change style or skill. Often prompting or retrieval is cheaper to try first.",["OpenAI fine-tuning","Hugging Face","Cloud platforms"]),
It("b8","Quantisation",null,250,275,"A lighter version of the same engine.","Storing the model with less precise numbers so it is smaller and cheaper to run, even on a laptop, at a small cost in accuracy.",["llama.cpp","Ollama","LM Studio"]),
It("b9","Multimodal",null,400,275,"Cameras and microphones on the front.","The model can take in images, audio, PDFs and sometimes video as well as text.",["Claude","GPT","Gemini"]),
It("b10","Benchmarks",null,550,275,"The dyno test.","Standard tests that score models. Useful for a rough guide, but they can be gamed and rarely match your own job. Test on your own work.",["Arena","SWE-bench","GDPval"])
],
