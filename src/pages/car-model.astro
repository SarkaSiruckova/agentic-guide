---
import '@fontsource/literata/400.css';
import '@fontsource/literata/500.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/500.css';
---
<!doctype html>
<html lang="en-GB">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>The agentic car | Agentic AI Field Guide</title>
<meta name="description" content="A zoomable car model of agentic AI: the model is the engine, the harness is the cabin, tools are the wheels. Click any part to see what it does and who makes it.">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<style is:global>
:root{--bg:#0F3A66;--line:#CFE8FF;--dim:#8DB8E0;--sub:#A9CDEE;--tx:#EAF6FF;--amb:#FFB84D;--panel:#154577;--bd:#3F6C9A;--sans:"Public Sans",system-ui,-apple-system,"Segoe UI",Arial,sans-serif;--serif:Literata,Georgia,"Times New Roman",serif;--mono:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--tx);font-family:var(--serif);-webkit-text-size-adjust:100%}
a{color:var(--line)}
.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
.page{max-width:1180px;margin:0 auto;padding:16px 20px 40px}
.top{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 20px;font-family:var(--sans);font-size:14px}
.top a{color:var(--sub);text-decoration:none;padding:6px 0}
.top a:hover,.top a:focus-visible{color:var(--tx);text-decoration:underline}
.top nav{display:flex;gap:20px}
h1{font-family:var(--sans);font-weight:500;font-size:26px;line-height:1.2;margin:14px 0 6px;color:var(--tx)}
.lede{font-size:16px;line-height:1.65;color:var(--sub);margin:0 0 16px;max-width:64ch}
.bar{display:flex;flex-wrap:wrap;align-items:center;gap:12px 24px;margin:0 0 14px;font-family:var(--sans);font-size:14px}
.lv{display:flex;flex-wrap:wrap;gap:8px}
.lv button{font:inherit;color:var(--tx);background:transparent;border:1px solid var(--bd);border-radius:6px;padding:7px 12px;cursor:pointer}
.lv button:hover{border-color:var(--line)}
.lv button[aria-current="true"]{background:var(--tx);color:var(--bg);border-color:var(--tx);font-weight:500}
.sty{display:flex;align-items:center;gap:10px;color:var(--sub);margin-left:auto}
.sty input{width:150px;accent-color:var(--line)}
button:focus-visible,input:focus-visible,a:focus-visible{outline:2px solid var(--amb);outline-offset:2px}
.grid{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:20px;align-items:start}
.stagebox{border:1px solid var(--bd);border-radius:12px;overflow:hidden;background:var(--bg)}
.stagebox svg{display:block;width:100%;height:auto}
.hs{cursor:pointer}
.hs:focus{outline:none}
.hs:focus-visible rect.f{stroke:#fff;stroke-width:2.5}
.hs:focus-visible circle.f{stroke:#fff;stroke-width:3}
.hs:hover rect.t{fill-opacity:.2}
.panel{background:var(--panel);border:1px solid var(--bd);border-radius:12px;padding:16px 18px;position:sticky;top:12px}
.panel h2{font-family:var(--sans);font-weight:500;font-size:18px;margin:0 0 10px;color:var(--tx)}
.panel .k{display:block;font-family:var(--sans);font-size:12px;color:var(--sub);margin:0 0 2px}
.panel p{font-size:15px;line-height:1.65;margin:0 0 12px;color:var(--tx)}
.chips{display:flex;flex-wrap:wrap;gap:6px;margin:4px 0 8px;padding:0;list-style:none}
.chips li{font-family:var(--sans);font-size:12.5px;border:1px solid var(--bd);border-radius:6px;padding:3px 9px;color:var(--tx)}
.note{font-family:var(--sans);font-size:12.5px;color:var(--sub);margin:0 0 10px}
.panel p.note{font-size:12.5px;line-height:1.5;margin:0 0 10px}
.panel .more{font-family:var(--sans);font-size:14px}
.parts{margin:16px 0 0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:8px;font-family:var(--sans);font-size:14px}
.parts button{width:100%;text-align:left;font:inherit;color:var(--tx);background:transparent;border:1px solid var(--bd);border-radius:6px;padding:9px 11px;cursor:pointer;display:flex;gap:9px;align-items:baseline}
.parts button:hover{border-color:var(--line)}
.parts button.sel{border-color:var(--tx);background:var(--panel)}
.parts button.z{border-color:var(--amb);color:var(--amb)}
.parts .n{font-family:var(--mono);font-size:12px;color:var(--sub)}
.parts small{display:block;font-size:12px;color:var(--sub)}
.foot{font-family:var(--sans);font-size:13px;line-height:1.6;color:var(--sub);margin:22px 0 0;max-width:80ch}
@media (max-width:900px){.grid{grid-template-columns:minmax(0,1fr)}.panel{position:static}.sty{margin-left:0}}
@media (prefers-reduced-motion:no-preference){.sweep{animation:sw 6s ease-in-out infinite alternate}}
@keyframes sw{from{transform:translateX(0)}to{transform:translateX(470px)}}
</style>
</head>
<body>
<div class="page">
<div class="top"><a href="/">Back to the guide</a><nav><a href="/concept-map/">Concept map</a></nav></div>
<h1>The agentic car</h1>
<p class="lede">A car has an engine, a cabin, wheels, fuel and roads to drive on. So does an AI agent. Pick a part to see what it does and who makes it, then zoom in to the engine or cabin, or out to the world.</p>
<div class="bar">
<div class="lv" id="lv" role="group" aria-label="Zoom level"></div>
<label class="sty"><span>Blueprint</span><input type="range" id="sty" min="0" max="100" step="1" value="50" aria-label="Visual style, from blueprint to heads-up display"><span>Jarvis</span></label>
</div>
<div class="grid">
<div>
<div class="stagebox" id="box">
<svg id="svg" viewBox="0 0 680 340" role="group" aria-label="Zoomable car model. The same parts are listed as buttons below the picture.">
<defs><marker id="arrow" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M2 1L8 5L2 9" fill="none" stroke="context-stroke" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>
<g id="stage"></g>
</svg>
</div>
<ul class="parts" id="parts" aria-label="Parts in this view"></ul>
</div>
<aside class="panel" id="panel" aria-live="polite"></aside>
</div>
<p class="sr-only" id="live" aria-live="polite"></p>
<p class="foot">Provider names are examples to show what each part is. They are not a ranking or a recommendation, and they change quickly. Snapshot: October 2026.</p>
</div>
<script is:inline>
(function(){
var MONO="ui-monospace,SFMono-Regular,Menlo,Consolas,monospace";
function hx(c){return [parseInt(c.substr(1,2),16),parseInt(c.substr(3,2),16),parseInt(c.substr(5,2),16)]}
function mix(a,b,t){var x=hx(a),y=hx(b);return "#"+x.map(function(v,i){var n=Math.round(v+(y[i]-v)*t);return (n<16?"0":"")+n.toString(16)}).join("")}
