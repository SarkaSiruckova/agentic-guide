It("w5","Your data and apps",null,100,250,"Everywhere the car can go: shops, offices, warehouses.","Your files, email, CRM and databases, reached through connectors. This is where the value is.",["Notion","Slack","Google Drive","Microsoft 365","A CRM such as Affinity"]),
It("w6","Garage and hosting",null,300,250,"Where the car is kept and runs when you are not there.","Hosting for agents you build yourself, so they can run on a schedule or a trigger.",["Vercel","Supabase","A cloud server","Your laptop"]),
It("w7","Fuel station",null,500,250,"Where you buy fuel by the litre.","The API: you pay per token (a chunk of text) for what the engine reads and writes.",["Claude API","OpenAI API","Gemini API"]),
It("w8","Servicing and checks",null,100,300,"Mechanics, inspections and the MOT.","Observability tools show what the agent did. Evals are repeatable tests that it still works after a change.",["LangSmith","Langfuse","Braintrust"]),
It("w9","Rules and regulators",null,300,300,"The Highway Code, the police and insurance.","Data protection law, AI regulation and your own AI policy decide what is allowed and who is responsible.",["UK GDPR","EU AI Act","Your own AI policy"]),
It("w10","Other drivers",null,500,300,"Other cars sharing the road.","Other agents, from other firms. A2A is an open standard that lets agents find each other and hand over tasks. It is hosted by the Linux Foundation.",["A2A protocol"])
],
