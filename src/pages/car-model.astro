function pal(i){return {i:i,line:mix("#CFE8FF","#5FD8FF",i),dim:mix("#8DB8E0","#2C9CC4",i),bg:mix("#0F3A66","#06121F",i),gc:mix("#6C9BC7","#1E5A7A",i),sub:mix("#A9CDEE","#86DAF3",i),amb:AMB,tx:TX}}
function T(x,y,s,sz,w,c,a){return '<text x="'+x+'" y="'+y+'" font-family="'+MONO+'" font-size="'+sz+'" font-weight="'+w+'" fill="'+c+'" text-anchor="'+(a||"start")+'" dominant-baseline="auto">'+s+'</text>'}
