function ar(a,b,c,d,col){return '<line x1="'+a+'" y1="'+b+'" x2="'+c+'" y2="'+d+'" stroke="'+col+'" stroke-width="1.3" marker-end="url(#arrow)"/>'}
var BODY="M62,200 C58,190 58,175 68,167 C120,152 190,138 250,128 C272,112 292,99 316,89 C350,80 420,78 452,84 C500,94 550,122 586,148 C602,152 610,162 612,178 L612,200 L548.5,200 A42,42 0 0 0 467.5,200 L245.5,200 A42,42 0 0 0 164.5,200 Z";
var GL1="M266,129 L318,98 C336,95 354,94 374,94 L374,129 Z",GL2="M386,129 L386,94 C410,93 432,94 452,98 C482,108 506,119 520,129 Z";
