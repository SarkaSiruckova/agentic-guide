for(k=0;k<5;k++){a=(18+72*k)*Math.PI/180;g+=ln((cx+7*Math.cos(a)).toFixed(1),(cy+7*Math.sin(a)).toFixed(1),(cx+25*Math.cos(a)).toFixed(1),(cy+25*Math.sin(a)).toFixed(1),c.dim,1.2)}return g}
function dstyle(c){return ' fill="none" stroke="'+c.dim+'" stroke-width="1" stroke-linejoin="round" stroke-linecap="round"'}

function It(id,name,sub,cx,cy,car,ai,p,o){var r={id:id,name:name,sub:sub,cx:cx,cy:cy,car:car,ai:ai,p:p||[]},k;o=o||{};for(k in o)r[k]=o[k];return r}
function Zm(id,name,sub,cx,cy,to,lname,o){return It(id,name,sub,cx,cy,null,null,[],Object.assign({zoom:true,to:to,lname:lname},o||{}))}
