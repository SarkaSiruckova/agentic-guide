---
/**
 * The concept map: every page of the guide as a route map, in reading order.
 * Built from the pages themselves at build time (titles, reading order,
 * "In one line", jargon terms and Related links), plus the hand-curated
 * journey stages, places and examples in src/data/concept-map.ts.
 * A standalone full-screen page, linked from the sidebar and the home page.
 */
import { getCollection } from 'astro:content';
import { parts, stages, places, examples } from '../data/concept-map';
import '@fontsource/literata/400.css';
import '@fontsource/literata/600.css';
import '@fontsource/public-sans/400.css';
import '@fontsource/public-sans/600.css';

const docs = await getCollection('docs');
const dirs = new Set(parts.map((p) => p.dir));
const plain = (s: string) =>
  s
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/<\/?mark>/g, '')
    .replace(/\*\*|`/g, '')
    .replace(/\s+/g, ' ')
    .trim();
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

const pages = docs
  .filter((e) => dirs.has(e.id.split('/')[0]))
  .map((e) => {
    const body = e.body ?? '';
    const url = '/' + e.id.replace(/\/index$/, '') + '/';
    const one = body.match(/\*\*In one line:\*\*\s*(.*)/);
    const jar = body.match(/## The jargon[^\n]*\n([\s\S]*?)(?=\n## )/);
    const terms = jar
      ? [...jar[1].matchAll(/^- \*\*(.+?)\*\*:?\s*(.*)$/gm)].map((m) => [m[1].replace(/:$/, ''), cap(plain(m[2])).slice(0, 220)])
      : [];
    const rel = body.match(/## Related[ \t]*\n([\s\S]*?)(?=\n## |\s*$)/);
    const related = rel
      ? [...rel[1].matchAll(/\]\((\/[^)#\s]*)/g)].map((m) => (m[1].endsWith('/') ? m[1] : m[1] + '/'))
      : [];
    return {
      id: url,
      t: e.data.title,
      g: e.id.split('/')[0],
      o: (e.data.sidebar as { order?: number } | undefined)?.order ?? 0,
      sl: (e.data.sidebar as { label?: string } | undefined)?.label,
      d: cap(plain(one ? one[1] : e.data.description ?? '')),
      r: related,
      j: terms,
      lower: body.toLowerCase(),
    };
  });

const known = new Set(pages.map((p) => p.id));
const warn = (where: string, url: string) => {
  if (!known.has(url)) console.warn(`[concept-map] ${where}: no page at ${url}, skipped`);
  return known.has(url);
};

const exampleHits: Record<string, string[]> = {};
for (const ex of examples) {
  const re = new RegExp(`\\b${ex.toLowerCase().replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\b`, 'g');
  pages
    .map((p) => [p.lower.match(re)?.length ?? 0, p.id] as [number, string])
    .filter(([n]) => n > 0)
    .sort((a, b) => b[0] - a[0])
    .slice(0, 3)
    .forEach(([, id]) => (exampleHits[id] ??= []).push(ex));
}

const data = {
  parts,
  stages: stages.map((s) => ({ ...s, pages: s.pages.filter((u) => warn(`stage ${s.id}`, u)) })),
  places: places.map((z) => ({ id: z.id, label: z.label })),
  pages: pages.map(({ lower, ...p }) => ({
    ...p,
    r: p.r.filter((u) => known.has(u) && u !== p.id),
    pl: places.filter((z) => z.pages.includes(p.id)).map((z) => z.id),
    pv: exampleHits[p.id] ?? [],
    st: stages.filter((s) => s.pages.includes(p.id)).map((s) => s.id),
  })),
};
places.forEach((z) => z.pages.forEach((u) => warn(`place ${z.id}`, u)));
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const total = data.pages.length;
---

<!doctype html>
<html lang="en-GB" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Concept map | Agentic AI Field Guide</title>
    <meta name="description" content="Every page of the Agentic AI Field Guide as a route map: what each idea builds on, what it leads to, and where its jargon comes up." />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      (function () {
        var t = '';
        try { t = localStorage.getItem('starlight-theme') || ''; } catch (e) {}
        if (t !== 'light' && t !== 'dark') t = matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        document.documentElement.dataset.theme = t;
      })();
    </script>
    <style is:global>
      :root{--bg:#151c1a;--bg2:#1e2725;--bg3:#24302d;--line:#2e3936;--t1:#f4f7f6;--t2:#c0cac8;--t3:#8b9895;--t4:#56635f;--acc:#6fb8a1;--accl:#1c3a33;--mark:#e3c95b;
      --p1:#6fb8a1;--p2:#79b4d9;--p3:#e3c95b;--p4:#e08a6d;--p5:#b49be0;--p6:#6fc9c1;--p7:#a3a9b0;--el:#8b9895;
      --z-app:#6fb8a1;--z-laptop:#79b4d9;--z-cloud:#e3c95b;--z-team:#b49be0;--z-channels:#e08a6d}
      [data-theme=light]{--bg:#fbfcfa;--bg2:#f2f5f3;--bg3:#e7ecea;--line:#c0cac8;--t1:#151c1a;--t2:#2e3936;--t3:#56635f;--t4:#8b9895;--acc:#2b6b58;--accl:#d8ebe3;--mark:#b8931c;
      --p1:#2b6b58;--p2:#2f6f99;--p3:#a07c10;--p4:#b5543c;--p5:#6d4fa3;--p6:#2a7f79;--p7:#5f656c;--el:#8b9895;
      --z-app:#2b6b58;--z-laptop:#2f6f99;--z-cloud:#a07c10;--z-team:#6d4fa3;--z-channels:#b5543c}
      *{box-sizing:border-box}
      html,body{margin:0;height:100%;background:var(--bg);color:var(--t1);font-family:'Public Sans',system-ui,sans-serif}
      body{display:flex;flex-direction:column;overflow:hidden}
      a{color:inherit}
      :focus-visible{outline:2px solid var(--acc);outline-offset:2px}
      header{display:flex;align-items:center;gap:14px;padding:10px 18px;border-bottom:1px solid var(--line);flex-wrap:wrap}
      .back{font-size:13px;color:var(--t3);text-decoration:none;white-space:nowrap}
      .back:hover{color:var(--t1)}
      .brand{font-weight:600;font-size:16px}
      .brand small{display:block;font-weight:400;color:var(--t3);font-size:12px;margin-top:2px}
      .search{position:relative;flex:1;min-width:200px;max-width:420px}
      #q{width:100%;font:inherit;font-size:14px;padding:8px 12px;border:1px solid var(--line);border-radius:8px;background:var(--bg2);color:var(--t1)}
      #sugg{position:absolute;top:40px;left:0;right:0;background:var(--bg2);border:1px solid var(--line);border-radius:8px;z-index:30;max-height:320px;overflow:auto;display:none;box-shadow:0 10px 30px rgba(0,0,0,.25)}
      .sg{padding:8px 12px;font-size:13px;cursor:pointer;display:flex;justify-content:space-between;gap:10px}
      .sg:hover,.sg.on{background:var(--bg3)}
      .sg span{color:var(--t3);font-size:11.5px;white-space:nowrap}
      .seg{display:flex;border:1px solid var(--line);border-radius:8px;overflow:hidden}
      .seg button{font:inherit;font-size:12.5px;padding:7px 11px;border:0;background:transparent;color:var(--t3);cursor:pointer}
      .seg button[aria-pressed=true]{background:var(--accl);color:var(--t1)}
      .btn{font:inherit;font-size:12.5px;padding:7px 11px;border:1px solid var(--line);border-radius:8px;background:transparent;color:var(--t2);cursor:pointer}
      .btn:hover{border-color:var(--acc)}
      .prog{font-size:12px;color:var(--t3);min-width:140px}
      .prog b{color:var(--t1);font-weight:600}
      .pbar{height:4px;background:var(--bg3);border-radius:3px;margin-top:5px;overflow:hidden}
      .pbar i{display:block;height:100%;width:0;background:var(--acc)}
      main{flex:1;display:flex;min-height:0;position:relative}
      #wrap{flex:1;overflow:hidden;position:relative;cursor:grab;touch-action:none}
      #wrap.drag{cursor:grabbing}
      #svg{display:block;width:100%;height:100%;user-select:none}
      .lbl{font-size:12.5px;fill:var(--t2)}
      .st{cursor:pointer;outline:none}
      .st:hover .lbl,.st:focus-visible .lbl{fill:var(--t1);font-weight:600}
      .st:focus-visible circle.dot{stroke-width:5}
      .dim{opacity:.18}
      .ph,.chipS{cursor:pointer}
      .ph:hover .pt{text-decoration:underline}
      #legend{position:absolute;left:14px;bottom:14px;background:var(--bg2);border:1px solid var(--line);border-radius:10px;padding:10px 12px;font-size:12px;color:var(--t2);line-height:1.8}
      #legend i{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:7px;vertical-align:-1px}
      #legend button{all:unset;cursor:pointer;display:block}
      #hint{position:absolute;right:14px;bottom:14px;font-size:12px;color:var(--t3)}
      aside{width:380px;border-left:1px solid var(--line);background:var(--bg2);overflow:auto;padding:20px 22px 30px}
      aside:not(.open){display:none}
      #nav{position:absolute;top:0;left:0;bottom:0;width:min(300px,86vw);background:var(--bg2);border-right:1px solid var(--line);z-index:50;overflow:auto;padding:12px 12px 40px;box-shadow:12px 0 30px rgba(0,0,0,.3)}
      #scrim{position:absolute;inset:0;background:rgba(0,0,0,.35);z-index:45}
      #nav[hidden],#scrim[hidden]{display:none}
      #nav a,#nav summary{display:block;padding:6px 10px;border-radius:6px;color:var(--t2);text-decoration:none;font-size:14.5px;cursor:pointer}
      #nav>a,#nav>details>summary{color:var(--t1);font-weight:600;font-size:15px}
      #nav a:hover,#nav summary:hover{background:var(--bg3);color:var(--t1)}
      #nav a.cur{background:var(--accl);color:var(--t1);font-weight:600}
      #nav details>a,#nav details>details{margin-left:12px}
      #nav details.sub>summary{font-weight:600;color:var(--t1)}
      #nav summary{list-style:none;display:flex;justify-content:space-between}
      #nav summary::after{content:'›';color:var(--t3);transition:transform .15s}
      #nav details[open]>summary::after{transform:rotate(90deg)}
      #nav summary::-webkit-details-marker{display:none}
      .kick{font-size:11.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--t3);display:flex;align-items:center;gap:8px}
      .kick i{width:10px;height:10px;border-radius:50%;display:inline-block}
      aside h2{font-family:'Literata',Georgia,serif;font-weight:600;font-size:22px;line-height:1.25;margin:8px 0 10px}
      .one{font-family:'Literata',Georgia,serif;font-size:15px;line-height:1.6;color:var(--t2);margin:0 0 14px}
      .acts{display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap}
      .acts a,.acts button{font:inherit;font-size:13px;padding:8px 12px;border-radius:8px;border:1px solid var(--line);background:var(--bg);color:var(--t1);text-decoration:none;cursor:pointer}
      .acts .pri{background:var(--acc);border-color:var(--acc);color:var(--bg);font-weight:600}
      .sec{margin-top:16px}
      .sec h3{font-size:12px;letter-spacing:.06em;text-transform:uppercase;color:var(--t3);margin:0 0 8px;font-weight:600}
      .li{all:unset;box-sizing:border-box;display:flex;align-items:center;gap:9px;padding:6px 8px;margin:0 -8px;width:calc(100% + 16px);border-radius:7px;cursor:pointer;font-size:14px;color:var(--t1)}
      .li:hover,.li:focus-visible{background:var(--bg3)}
      .li i{width:9px;height:9px;border-radius:50%;flex:none}
      .li span{color:var(--t3);font-size:12px;margin-left:auto;white-space:nowrap}
      .chips{display:flex;flex-wrap:wrap;gap:6px}
      .ch{font:inherit;font-size:12.5px;padding:4px 9px;border-radius:14px;border:1px solid var(--line);background:var(--bg);color:var(--t2);cursor:pointer}
      .ch:hover{border-color:var(--acc);color:var(--t1)}
      .ch.ex{cursor:default;border-style:dashed}
      .note{font-size:12px;color:var(--t3);margin-top:6px;line-height:1.5}
      .x{float:right;border:0;background:transparent;color:var(--t3);font-size:22px;cursor:pointer;margin:-6px -6px 0 0;line-height:1}
      #list{display:none;overflow:auto;padding:12px 16px 40px;flex:1}
      #list details{border-bottom:1px solid var(--line);padding:6px 0}
      #list summary{cursor:pointer;padding:8px 0;font-weight:600;font-size:15px;list-style:none;display:flex;gap:10px;align-items:center}
      #list summary small{font-weight:400;color:var(--t3);font-size:12px;margin-left:auto}
      #list .stage-row{display:flex;gap:6px;overflow-x:auto;padding:4px 0 12px}
      #list .stop{all:unset;box-sizing:border-box;display:flex;gap:12px;align-items:center;padding:7px 4px;width:100%;font-size:14px;cursor:pointer;color:var(--t2)}
      #list .stop i{width:12px;height:12px;border-radius:50%;border:3px solid var(--pc);flex:none}
      #list .stop.read i{background:var(--pc)}
      .sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
      @media (max-width:820px){
        header{gap:10px;padding:10px 14px}
        .search{order:5;flex-basis:100%;max-width:none}
        #colour,#fit,#hint,#legend{display:none}
        #wrap{display:none}
        #list{display:block}
        aside{position:fixed;inset:auto 0 0 0;width:auto;max-height:78vh;border-left:0;border-top:1px solid var(--line);border-radius:14px 14px 0 0;box-shadow:0 -10px 40px rgba(0,0,0,.35);z-index:40;display:none}
        aside.open{display:block}
      }
    </style>
  </head>
  <body>
    <header>
      <button class="btn" id="menuBtn" type="button" aria-expanded="false" aria-controls="nav">☰ Menu</button>
      <div class="brand">Concept map<small>{total} pages · 7 Parts · 3 side trips</small></div>
      <div class="search">
        <label class="sr" for="q">Find a page or a term</label>
        <input id="q" placeholder="Find a page or a term, e.g. webhook" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="sugg" />
        <div id="sugg" role="listbox"></div>
      </div>
      <div class="seg" id="colour" role="group" aria-label="Colour the stops by">
        <button type="button" data-c="part" aria-pressed="true">Colour by Part</button>
        <button type="button" data-c="zone" aria-pressed="false">Where it runs</button>
      </div>
      <div class="prog"><b id="pn">0</b> of {total} ticked off<div class="pbar"><i id="pb"></i></div></div>
      <button class="btn" id="help" type="button">How to use</button>
      <button class="btn" id="fit" type="button">Fit</button>
      <button class="btn" id="theme" type="button">Light</button>
    </header>
    <main>
      <div id="wrap">
        <svg id="svg" role="group" aria-label="Map of every page in the guide, in reading order"><g id="gArcs"></g><g id="gMap"></g></svg>
        <div id="legend"></div>
        <div id="hint">Scroll to zoom · drag to move · click a stop</div>
      </div>
      <div id="list"></div>
      <aside id="side" aria-live="polite"></aside>
      <div id="scrim" hidden></div>
      <nav id="nav" aria-label="Guide menu" hidden></nav>
    </main>
    <script type="application/json" id="cm-data" set:html={json} />
    <script is:inline>
(function(){
const D=JSON.parse(document.getElementById('cm-data').textContent);
const PARTS=D.parts,P=D.pages,BY={},PI={};
PARTS.forEach((p,i)=>PI[p.dir]=i);P.forEach(p=>BY[p.id]=p);
const KEY='guide-map-read';let read=new Set();
try{read=new Set(JSON.parse(localStorage.getItem(KEY)||'[]'));}catch(e){}
function save(){try{localStorage.setItem(KEY,JSON.stringify([...read]));}catch(e){}}
const css=v=>getComputedStyle(document.documentElement).getPropertyValue(v).trim();
const esc=s=>String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
const NS='http://www.w3.org/2000/svg';
function el(t,a,par){const e=document.createElementNS(NS,t);for(const k in a)e.setAttribute(k,a[k]);if(par)par.appendChild(e);return e;}
const cols=PARTS.map(p=>P.filter(x=>x.g==p.dir).sort((a,b)=>a.o-b.o||a.t.localeCompare(b.t)));
const chain=[];cols.forEach((c,i)=>{if(!PARTS[i].side)c.forEach(p=>chain.push(p));});
P.forEach(p=>{p.gi=PI[p.g]*100+p.o;p.side=!!PARTS[PI[p.g]].side;p.back=[];});
P.forEach(p=>p.r.forEach(r=>{if(BY[r])BY[r].back.push(p.id);}));
P.forEach(p=>{p.links=[...new Set([...p.r,...p.back])].filter(i=>BY[i]&&i!==p.id);});
chain.forEach((p,i)=>{p.prev=chain[i-1];p.next=chain[i+1];});
const NMAIN=PARTS.filter(p=>!p.side).length;
const CW=178,EW=162,GAP=60,TOP=176,DY=42;
function colx(i){return i<NMAIN?30+i*CW:30+NMAIN*CW+GAP+(i-NMAIN)*EW;}
cols.forEach((c,i)=>c.forEach((p,k)=>{p.x=colx(i)+14;p.y=TOP+k*DY;}));
const W=colx(PARTS.length-1)+EW+20,H=TOP+Math.max(...cols.map(c=>c.length))*DY+20;
let colourBy='part',sel=null;
const svg=document.getElementById('svg'),gMap=document.getElementById('gMap'),gArcs=document.getElementById('gArcs');
let view={x:0,y:0,w:W,h:H};
function setVB(){svg.setAttribute('viewBox',`${view.x} ${view.y} ${view.w} ${view.h}`);}
function fit(){const r=svg.getBoundingClientRect();if(!r.width)return;const s=Math.max((H+10)/r.height,(colx(NMAIN)+40)/r.width);view={w:r.width*s,h:r.height*s,x:0,y:-4};setVB();}
function wrapText(t,n){const w=t.split(' ');const L=[];let c='';w.forEach(x=>{if((c+' '+x).trim().length>n&&c){L.push(c);c=x;}else c=(c+' '+x).trim();});if(c)L.push(c);if(L.length>2){L.length=2;L[1]=L[1].replace(/\s*\S*$/,'')+'…';}return L;}
function pcol(p){return css(PARTS[PI[p.g]].colour);}
function scol(p){if(colourBy=='part')return pcol(p);return p.pl.length?css('--z-'+p.pl[0]):css('--t4');}
function pname(p){const x=PARTS[PI[p.g]];return x.kicker+' · '+x.title;}
const nextUnread=()=>chain.find(p=>!read.has(p.id))||chain[0];

function hot(){
  if(!sel)return null;
  if(sel.kind=='page'){const s=new Set(sel.v.links);s.add(sel.v.id);if(sel.v.prev)s.add(sel.v.prev.id);if(sel.v.next)s.add(sel.v.next.id);return s;}
  if(sel.kind=='stage')return new Set(sel.v.pages);
  if(sel.kind=='term')return new Set(P.filter(p=>p.j.some(j=>j[0].toLowerCase()==sel.v.toLowerCase())).map(p=>p.id));
  if(sel.kind=='part')return new Set(cols[sel.v].map(p=>p.id));
  if(sel.kind=='zone')return new Set(P.filter(p=>p.pl.includes(sel.v)).map(p=>p.id));
}
function draw(){
  gMap.innerHTML='';const h=hot();
  const st=D.stages,x0=colx(0)+10,x1=colx(NMAIN-1)+CW-20,jy=34;
  el('text',{x:x0,y:16,'font-size':11,fill:css('--t3'),'letter-spacing':'.06em'},gMap).textContent='THE JOURNEY: FROM ONE CHAT TO A WHOLE TEAM';
  el('line',{x1:x0,y1:jy+14,x2:x1,y2:jy+14,stroke:css('--line'),'stroke-width':2},gMap);
  st.forEach((s,i)=>{const x=x0+(x1-x0)*i/(st.length-1);const on=sel&&sel.kind=='stage'&&sel.v===s;const w=s.label.length*7.4+24;
    const g=el('g',{class:'chipS',tabindex:0,role:'button','aria-label':'Journey stage: '+s.label},gMap);
    el('rect',{x:x-w/2,y:jy,width:w,height:28,rx:14,fill:on?css('--acc'):css('--bg2'),stroke:on?css('--acc'):css('--line')},g);
    el('text',{x,y:jy+18.5,'text-anchor':'middle','font-size':12.5,'font-weight':600,fill:on?css('--bg'):css('--t1')},g).textContent=s.label;
    if(i<st.length-1){const xn=x0+(x1-x0)*(i+1)/(st.length-1);el('text',{x:(x+xn)/2,y:jy+19,'text-anchor':'middle','font-size':12,fill:css('--t4')},gMap).textContent='→';}
    act(g,()=>select({kind:'stage',v:s}));s.x=x;s.y=jy+28;});
  if(PARTS.length>NMAIN){el('text',{x:colx(NMAIN),y:16,'font-size':11,fill:css('--t3'),'letter-spacing':'.06em'},gMap).textContent='SIDE TRIPS: DIP IN ANY TIME';
    el('line',{x1:colx(NMAIN),y1:jy+14,x2:colx(PARTS.length-1)+EW-20,y2:jy+14,stroke:css('--line'),'stroke-width':1,'stroke-dasharray':'3 4'},gMap);}
  cols.forEach((c,i)=>{const p0=PARTS[i];const x=colx(i);const col=css(p0.colour);const side=!!p0.side;
    const hg=el('g',{class:'ph',tabindex:0,role:'button','aria-label':p0.kicker+': '+p0.title},gMap);
    el('text',{x:x+2,y:98,'font-size':11,'font-weight':600,fill:col,'letter-spacing':'.06em'},hg).textContent=p0.kicker.toUpperCase();
    wrapText(p0.title,20).forEach((l,k)=>{el('text',{x:x+2,y:116+k*16,'font-size':14,'font-weight':600,fill:css('--t1'),class:'pt'},hg).textContent=l;});
    const nr=c.filter(p=>read.has(p.id)).length;
    el('text',{x:x+2,y:TOP-18,'font-size':11.5,fill:css('--t3')},hg).textContent=`${c.length} pages`+(nr?` · ${nr} ticked`:'');
    act(hg,()=>select({kind:'part',v:i}));
    if(c.length>1)el('line',{x1:x+14,y1:c[0].y,x2:x+14,y2:c[c.length-1].y,stroke:colourBy=='part'?col:css('--line'),'stroke-width':side?3:5,'stroke-linecap':'round','stroke-dasharray':side?'2 6':'',opacity:h&&!c.some(p=>h.has(p.id))?.2:1},gMap);
    c.forEach(p=>{const g=el('g',{class:'st'+(h&&!h.has(p.id)?' dim':''),tabindex:0,role:'button','aria-label':p.t+(read.has(p.id)?' (ticked off)':'')},gMap);const sc=scol(p);const isR=read.has(p.id);const isSel=sel&&sel.kind=='page'&&sel.v===p;
      el('circle',{class:'dot',cx:p.x,cy:p.y,r:isSel?9:7,fill:isR?sc:css('--bg'),stroke:sc,'stroke-width':3},g);
      if(isSel)el('circle',{cx:p.x,cy:p.y,r:14,fill:'none',stroke:css('--t1'),'stroke-width':1.5},g);
      el('rect',{x:p.x-12,y:p.y-16,width:CW-20,height:34,fill:'transparent'},g);
      const L=wrapText(p.t,side?18:20);L.forEach((l,k)=>{const t=el('text',{x:p.x+16,y:p.y+(L.length==1?4:-3+k*14),class:'lbl'},g);t.textContent=l;if(isSel){t.style.fontWeight=600;t.style.fill=css('--t1');}});
      act(g,()=>select({kind:'page',v:p}));
      g.onmouseenter=()=>{if(!sel)arcs(p,true);};g.onmouseleave=()=>{if(!sel)gArcs.innerHTML='';};});});
  legend();progress();
  if(sel&&sel.kind=='page')arcs(sel.v,false);else if(sel&&sel.kind=='stage')stageLines(sel.v);else gArcs.innerHTML='';
}
function act(g,fn){g.addEventListener('click',e=>{e.stopPropagation();if(moved<5)fn();});g.addEventListener('keydown',e=>{if(e.key=='Enter'||e.key==' '){e.preventDefault();fn();}});}
function curve(a,b,col,dash,w){const dx=b.x-a.x,dy=b.y-a.y;let d;
  if(Math.abs(dx)<5){const bow=-Math.min(90,30+Math.abs(dy)*.25);d=`M${a.x},${a.y} C${a.x+bow},${a.y} ${b.x+bow},${b.y} ${b.x},${b.y}`;}
  else{const lift=Math.min(120,Math.abs(dx)*.18+20);d=`M${a.x},${a.y} C${a.x+dx*.35},${a.y-lift} ${b.x-dx*.35},${b.y-lift} ${b.x},${b.y}`;}
  el('path',{d,fill:'none',stroke:col,'stroke-width':w,'stroke-dasharray':dash||'',opacity:.9},gArcs);}
function arcs(p,light){gArcs.innerHTML='';const acc=css('--acc'),t3=css('--t3');
  p.links.forEach(i=>{const q=BY[i];const later=q.side||p.side||q.gi>p.gi;curve(p,q,later?acc:t3,later?'':'4 4',light?1.2:1.8);});}
function stageLines(s){gArcs.innerHTML='';s.pages.forEach(i=>{const q=BY[i];if(!q)return;el('path',{d:`M${s.x},${s.y} C${s.x},${s.y+60} ${q.x},${q.y-80} ${q.x},${q.y-9}`,fill:'none',stroke:css('--acc'),'stroke-width':1.6,opacity:.8},gArcs);});}
function legend(){const L=document.getElementById('legend');
  if(colourBy=='part')L.innerHTML=`<div><i style="background:var(--bg);border:3px solid var(--p3)"></i>not ticked off yet</div><div><i style="background:var(--p3)"></i>ticked off</div><div style="margin-top:4px;color:var(--t3)">When you pick a stop:<br><span style="display:inline-block;width:18px;border-top:2px solid var(--acc);vertical-align:middle"></span> leads on to &nbsp;<span style="display:inline-block;width:18px;border-top:2px dashed var(--t3);vertical-align:middle"></span> builds on</div>`;
  else L.innerHTML=D.places.map(z=>`<button type="button" data-z="${z.id}"><i style="background:var(--z-${z.id})"></i>${esc(z.label)}</button>`).join('')+`<div><i style="background:var(--t4)"></i>an idea, not a place</div>`;
  L.querySelectorAll('[data-z]').forEach(d=>d.onclick=()=>select({kind:'zone',v:d.dataset.z}));}
function progress(){const n=read.size;document.getElementById('pn').textContent=n;document.getElementById('pb').style.width=(n/P.length*100)+'%';}

const side=document.getElementById('side');
function li(p,extra){return `<button type="button" class="li" data-id="${p.id}"><i style="background:${read.has(p.id)?pcol(p):'transparent'};border:2px solid ${pcol(p)}"></i>${esc(p.t)}<span>${esc(extra==null?PARTS[PI[p.g]].kicker:extra)}</span></button>`;}
function chip(attr,val,label,title){return `<button type="button" class="ch" ${attr}="${esc(val)}"${title?` title="${esc(title)}"`:''}>${esc(label)}</button>`;}
function openPanel(on){side.classList.toggle('open',on);}
function select(s){sel=s;renderSide();draw();renderList();openPanel(!!s);if(s)side.scrollTop=0;}
function renderSide(){
  if(!sel){const nu=nextUnread();side.innerHTML=`<button type="button" class="x" aria-label="Close">×</button><div class="kick">How to use this map</div><h2>Every page, in reading order</h2><p class="one">Each column is a Part, read top to bottom, left to right. The bar across the top is the journey the guide takes you on. Pick any stop to see what it builds on, what it leads to and the jargon it introduces.</p><div class="sec"><h3>Try</h3><div class="chips">${chip('data-st','agents','The Agents stage')}${chip('data-term','Prompt injection','Where prompt injection comes up')}${chip('data-pid','/data/from-me-to-us/','From me to us')}${chip('data-zone','cloud','What runs in the cloud')}</div></div><div class="sec"><h3>${read.size?'Pick up where you left off':'Start at the beginning'}</h3>${li(nu,read.size?'next to read':'Part 1')}</div><p class="note" style="margin-top:18px">Tick pages off as you read them. Your ticks stay in this browser only; nothing is sent anywhere.</p>`;bind();return;}
  let h='<button type="button" class="x" aria-label="Close">×</button>';
  if(sel.kind=='page'){const p=sel.v;const L=p.links.map(i=>BY[i]);
    const bef=L.filter(q=>!q.side&&!p.side&&q.gi<p.gi).sort((a,b)=>a.gi-b.gi);
    const aft=L.filter(q=>!q.side&&(q.gi>p.gi||p.side)).sort((a,b)=>a.gi-b.gi);
    const tr=L.filter(q=>q.side).sort((a,b)=>a.gi-b.gi);
    h+=`<div class="kick"><i style="background:${pcol(p)}"></i>${esc(pname(p))}</div><h2>${esc(p.t)}</h2><p class="one">${esc(p.d)}</p>
    <div class="acts"><a class="pri" href="${p.id}">Read this page</a><button type="button" id="mk">${read.has(p.id)?'Untick':'Tick off as read'}</button></div>`;
    if(p.next||p.prev)h+=`<div class="sec"><h3>In reading order</h3>${p.prev?li(p.prev,'before'):''}${p.next?li(p.next,'next up'):''}</div>`;
    if(bef.length)h+=`<div class="sec"><h3>Builds on</h3>${bef.map(q=>li(q)).join('')}</div>`;
    if(aft.length)h+=`<div class="sec"><h3>Leads on to</h3>${aft.map(q=>li(q)).join('')}</div>`;
    if(tr.length)h+=`<div class="sec"><h3>Side trips from here</h3>${tr.map(q=>li(q,'')).join('')}</div>`;
    if(p.st.length)h+=`<div class="sec"><h3>Journey stage</h3><div class="chips">${p.st.map(s=>chip('data-st',s,D.stages.find(x=>x.id==s).label)).join('')}</div></div>`;
    if(p.j.length)h+=`<div class="sec"><h3>Jargon on this page (${p.j.length})</h3><div class="chips">${p.j.map(j=>chip('data-term',j[0],j[0],j[1])).join('')}</div><p class="note">Pick a term to see every page that uses it.</p></div>`;
    if(p.pl.length)h+=`<div class="sec"><h3>Where it runs</h3><div class="chips">${p.pl.map(z=>chip('data-zone',z,D.places.find(x=>x.id==z).label)).join('')}</div></div>`;
    if(p.pv.length)h+=`<div class="sec"><h3>Examples named here</h3><div class="chips">${p.pv.map(v=>`<span class="ch ex">${esc(v)}</span>`).join('')}</div><p class="note">Examples to make the idea concrete, not recommendations.</p></div>`;}
  else if(sel.kind=='term'){const t=sel.v;const ps=P.filter(p=>p.j.some(j=>j[0].toLowerCase()==t.toLowerCase())).sort((a,b)=>a.gi-b.gi);const m=ps[0]&&ps[0].j.find(j=>j[0].toLowerCase()==t.toLowerCase());
    h+=`<div class="kick">Jargon term</div><h2>${esc(t)}</h2><p class="one">${esc(m?m[1]:'')}</p><div class="sec"><h3>Comes up on ${ps.length} page${ps.length==1?'':'s'}${ps[0]?', first in '+esc(PARTS[PI[ps[0].g]].kicker):''}</h3>${ps.map(q=>li(q)).join('')}</div><div class="acts" style="margin-top:14px"><a href="/reference/glossary/">Open the glossary</a></div>`;}
  else if(sel.kind=='stage'){const s=sel.v,i=D.stages.indexOf(s);h+=`<div class="kick">Journey stage ${i+1} of ${D.stages.length}</div><h2>${esc(s.label)}</h2><p class="one">${esc(s.text)}</p><div class="sec"><h3>Where the guide covers it</h3>${s.pages.map(u=>BY[u]).filter(Boolean).map(q=>li(q)).join('')}</div><div class="sec"><h3>Along the journey</h3><div class="chips">${i?chip('data-st',D.stages[i-1].id,'← '+D.stages[i-1].label):''}${i<D.stages.length-1?chip('data-st',D.stages[i+1].id,D.stages[i+1].label+' →'):''}</div></div>`;}
  else if(sel.kind=='part'){const c=cols[sel.v],p0=PARTS[sel.v];const terms=new Set();c.forEach(p=>p.j.forEach(j=>terms.add(j[0])));const out={};c.forEach(p=>p.links.forEach(i=>{const q=BY[i];if(q.g!=p0.dir)out[q.g]=(out[q.g]||0)+1;}));
    h+=`<div class="kick"><i style="background:${css(p0.colour)}"></i>${esc(p0.kicker)}</div><h2>${esc(p0.title)}</h2><div class="sec"><h3>${c.length} pages · ${c.filter(p=>read.has(p.id)).length} ticked off</h3>${c.map(q=>li(q,'')).join('')}</div><div class="sec"><h3>Connects to</h3><div class="chips">${Object.entries(out).sort((a,b)=>b[1]-a[1]).map(([g,n])=>{const x=PARTS[PI[g]];return chip('data-part',PI[g],(x.side?x.title:x.kicker)+' · '+n+' links');}).join('')}</div></div><div class="sec"><h3>Introduces ${terms.size} terms</h3><div class="chips">${[...terms].map(t=>chip('data-term',t,t)).join('')}</div></div>`;}
  else if(sel.kind=='zone'){const z=D.places.find(x=>x.id==sel.v);const ps=P.filter(p=>p.pl.includes(sel.v)).sort((a,b)=>a.gi-b.gi);h+=`<div class="kick">Where it runs</div><h2>${esc(z.label)}</h2><div class="sec"><h3>${ps.length} pages</h3>${ps.map(q=>li(q)).join('')}</div>`;}
  side.innerHTML=h;bind();
}
function bind(){
  side.querySelectorAll('.li').forEach(d=>d.onclick=()=>select({kind:'page',v:BY[d.dataset.id]}));
  side.querySelectorAll('[data-term]').forEach(d=>d.onclick=()=>select({kind:'term',v:d.dataset.term}));
  side.querySelectorAll('[data-st]').forEach(d=>d.onclick=()=>select({kind:'stage',v:D.stages.find(s=>s.id==d.dataset.st)}));
  side.querySelectorAll('[data-zone]').forEach(d=>d.onclick=()=>select({kind:'zone',v:d.dataset.zone}));
  side.querySelectorAll('[data-part]').forEach(d=>d.onclick=()=>select({kind:'part',v:+d.dataset.part}));
  side.querySelectorAll('[data-pid]').forEach(d=>d.onclick=()=>select({kind:'page',v:BY[d.dataset.pid]}));
  const x=side.querySelector('.x');if(x)x.onclick=()=>select(null);
  const mk=document.getElementById('mk');if(mk)mk.onclick=()=>{const id=sel.v.id;read.has(id)?read.delete(id):read.add(id);save();renderSide();draw();renderList();};
}
// phone layout: a list of Parts
const list=document.getElementById('list');let openParts=new Set([PI[nextUnread().g]]);
function renderList(){
  list.innerHTML=`<div class="stage-row">${D.stages.map(s=>chip('data-st',s.id,s.label)).join('')}</div>`+cols.map((c,i)=>{const p0=PARTS[i];return `<details data-i="${i}"${openParts.has(i)?' open':''}><summary><i style="width:10px;height:10px;border-radius:50%;background:${css(p0.colour)}"></i>${esc(p0.kicker)} · ${esc(p0.title)}<small>${c.filter(p=>read.has(p.id)).length}/${c.length}</small></summary>${c.map(p=>`<button type="button" class="stop${read.has(p.id)?' read':''}" data-id="${p.id}" style="--pc:${css(p0.colour)}"><i></i>${esc(p.t)}</button>`).join('')}</details>`;}).join('');
  list.querySelectorAll('.stop').forEach(b=>b.onclick=()=>select({kind:'page',v:BY[b.dataset.id]}));
  list.querySelectorAll('[data-st]').forEach(b=>b.onclick=()=>select({kind:'stage',v:D.stages.find(s=>s.id==b.dataset.st)}));
  list.querySelectorAll('details').forEach(d=>d.ontoggle=()=>{const i=+d.dataset.i;d.open?openParts.add(i):openParts.delete(i);});
}
// search
const q=document.getElementById('q'),sg=document.getElementById('sugg');
const TERMS={};P.forEach(p=>p.j.forEach(j=>{const k=j[0].toLowerCase();TERMS[k]=TERMS[k]||{t:j[0],n:0};TERMS[k].n++;}));
let sIdx=0,sRes=[];
function showSugg(on){sg.style.display=on?'block':'none';q.setAttribute('aria-expanded',on?'true':'false');}
q.oninput=()=>{const v=q.value.trim().toLowerCase();if(!v){showSugg(false);return;}
  const a=P.filter(p=>p.t.toLowerCase().includes(v)).slice(0,6).map(p=>({k:'page',v:p,l:p.t,m:PARTS[PI[p.g]].kicker}));
  const b=Object.values(TERMS).filter(t=>t.t.toLowerCase().includes(v)).sort((x,y)=>y.n-x.n).slice(0,6).map(t=>({k:'term',v:t.t,l:t.t,m:`term · ${t.n} page${t.n>1?'s':''}`}));
  const c=D.stages.filter(s=>s.label.toLowerCase().includes(v)).map(s=>({k:'stage',v:s,l:s.label,m:'journey stage'}));
  sRes=[...c,...a,...b];sIdx=0;sg.innerHTML=sRes.map((r,i)=>`<div class="sg${i?'':' on'}" role="option" data-i="${i}">${esc(r.l)}<span>${esc(r.m)}</span></div>`).join('')||'<div class="sg">No match</div>';showSugg(true);
  sg.querySelectorAll('[data-i]').forEach(d=>d.onmousedown=()=>pickS(+d.dataset.i));};
function pickS(i){const r=sRes[i];if(!r)return;select({kind:r.k,v:r.v});showSugg(false);q.value='';q.blur();}
q.onkeydown=e=>{if(e.key=='Enter')pickS(sIdx);if(e.key=='Escape'){showSugg(false);q.value='';}if(e.key=='ArrowDown'||e.key=='ArrowUp'){sIdx=Math.max(0,Math.min(sRes.length-1,sIdx+(e.key=='ArrowDown'?1:-1)));sg.querySelectorAll('.sg').forEach((d,i)=>d.classList.toggle('on',i==sIdx));e.preventDefault();}};
q.onblur=()=>setTimeout(()=>showSugg(false),150);
// controls
document.querySelectorAll('#colour button').forEach(b=>b.onclick=()=>{colourBy=b.dataset.c;document.querySelectorAll('#colour button').forEach(x=>x.setAttribute('aria-pressed',x===b?'true':'false'));draw();});
const tb=document.getElementById('theme');
function themeLabel(){tb.textContent=document.documentElement.dataset.theme=='dark'?'Light':'Dark';}
tb.onclick=()=>{const r=document.documentElement;r.dataset.theme=r.dataset.theme=='dark'?'light':'dark';try{localStorage.setItem('starlight-theme',r.dataset.theme);}catch(e){}themeLabel();draw();renderList();renderSide();};
themeLabel();
document.getElementById('fit').onclick=fit;
const wrap=document.getElementById('wrap');let drag=null,moved=0;
wrap.addEventListener('pointerdown',e=>{drag=[e.clientX,e.clientY];moved=0;});
addEventListener('pointermove',e=>{if(!drag)return;const r=svg.getBoundingClientRect();const s=view.w/r.width;const dx=e.clientX-drag[0],dy=e.clientY-drag[1];moved+=Math.abs(dx)+Math.abs(dy);if(moved>4)wrap.classList.add('drag');view.x-=dx*s;view.y-=dy*s;drag=[e.clientX,e.clientY];setVB();});
addEventListener('pointerup',()=>{drag=null;wrap.classList.remove('drag');});
svg.addEventListener('click',e=>{if(moved<5&&e.target===svg)select(null);});
wrap.addEventListener('wheel',e=>{e.preventDefault();const r=svg.getBoundingClientRect();const mx=view.x+(e.clientX-r.left)/r.width*view.w,my=view.y+(e.clientY-r.top)/r.height*view.h;const f=Math.exp(e.deltaY*.0012);const nw=Math.max(400,Math.min(W*2,view.w*f));const k=nw/view.w;view.x=mx-(mx-view.x)*k;view.y=my-(my-view.y)*k;view.w=nw;view.h*=k;setVB();},{passive:false});
let lastW=0;
new ResizeObserver(()=>{const r=svg.getBoundingClientRect();if(!r.width)return;if(!lastW)fit();else{const k=view.w/lastW;view.w=r.width*k;view.h=r.height*k;setVB();}lastW=r.width;}).observe(wrap);
document.getElementById('help').onclick=()=>{const on=!(side.classList.contains('open')&&!sel);sel=null;renderSide();draw();openPanel(on);};
// guide menu drawer
const nav=document.getElementById('nav'),scrim=document.getElementById('scrim'),mb=document.getElementById('menuBtn');
function link(href,label,cur){return `<a href="${href}"${cur?' class="cur" aria-current="page"':''}>${esc(label)}</a>`;}
let n=0;nav.innerHTML=link('/','Home')+PARTS.map((p,i)=>p.side?'':`<details><summary>${++n}. ${esc(p.title.replace(' (optional)',''))}</summary>${cols[i].map(q=>link(q.id,q.sl||q.t)).join('')}</details>`).join('')
  +link('/concept-map/',(n+1)+'. Concept map',true)
  +link('/car-model/',(n+2)+'. The agentic car')
  +`<details><summary>Electives</summary>${PARTS.map((p,i)=>p.side?`<details class="sub"><summary>${esc(p.title)}</summary>${cols[i].map(q=>link(q.id,q.sl||q.t)).join('')}</details>`:'').join('')}</details>`
  +`<details><summary>Reference</summary>${link('/reference/glossary/','Glossary')}${link('/reference/confusables/','Confusables')}${link('/tags/','Browse by tag')}${link('/reference/recently-added/','Recently added')}</details>`;
function menu(on){nav.hidden=!on;scrim.hidden=!on;mb.setAttribute('aria-expanded',on?'true':'false');if(on)nav.querySelector('a').focus();}
mb.onclick=()=>menu(nav.hidden);scrim.onclick=()=>menu(false);
addEventListener('keydown',e=>{if(e.key=='Escape'&&!nav.hidden)menu(false);});
addEventListener('keydown',e=>{if(e.key=='Escape'&&document.activeElement!==q)select(null);if(e.key=='/'&&document.activeElement!==q){e.preventDefault();q.focus();}});
const fromHash=()=>BY[decodeURIComponent(location.hash.slice(1))];
addEventListener('hashchange',()=>{const p=fromHash();if(p)select({kind:'page',v:p});});
const hp=fromHash();select(hp?{kind:'page',v:hp}:null);
})();
    </script>
  </body>
</html>
